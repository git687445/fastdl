{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FastDL",
  "version": "0.1.0",
  "identifier": "com.fastdl.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "title": "FastDL · 高速下载器",
        "width": 880,
        "height": 580,
        "minWidth": 620,
        "minHeight": 420,
        "center": true
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"],
    "category": "public.app-category.utilities",
    "shortDescription": "多线程分段高速下载器"
  }
}
